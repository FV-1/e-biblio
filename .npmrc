# Les dépendances du serveur n'ont besoin d'aucun script d'installation :
# better-sqlite3 embarque ses binaires (Windows, macOS, Linux). Mais lors d'une
# installation depuis package-lock.json, npm oublie son « gypfile: false » et
# tente de le compiler, ce qui échoue sans Visual Studio ou Xcode.
# N'affecte pas `npm start` ni `npm run …`, ni le dossier desktop/.
ignore-scripts=true
